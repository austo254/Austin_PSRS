# Copy to .env for local development. Placeholders only - never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/psrs
CLIENT_URL=http://localhost:5173
COOKIE_SAMESITE=lax
SERVE_CLIENT=false
SESSION_TTL_HOURS=12
SESSION_TTL_REMEMBER_DAYS=30
UPLOAD_STORAGE_PROVIDER=none
UPLOAD_MAX_BYTES=5242880
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
PASSWORD_RESET_MODE=disabled
LOG_LEVEL=info
# Seeding (only read by db:seed). Choose your own strong values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true
